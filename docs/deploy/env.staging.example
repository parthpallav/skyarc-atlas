# Copy to `.env.staging` on the VPS (never commit secrets).
# Staging uses a dedicated database name — do not reuse production DATABASE_URL or customer dumps.

# --- Postgres (internal only; no host publish) ---
POSTGRES_USER=skyarc_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_STAGING_PASSWORD
POSTGRES_DB=skyarc_atlas_staging
DATABASE_URL=postgresql://skyarc_staging:REPLACE_WITH_STRONG_STAGING_PASSWORD@postgres:5432/skyarc_atlas_staging
ORBIT_DATABASE_URL=postgresql://skyarc_staging:REPLACE_WITH_STRONG_STAGING_PASSWORD@postgres:5432/skyarc_atlas_staging
PULSE_DATABASE_URL=postgresql://skyarc_staging:REPLACE_WITH_STRONG_STAGING_PASSWORD@postgres:5432/skyarc_atlas_staging
BRIDGE_DATABASE_URL=postgresql://skyarc_staging:REPLACE_WITH_STRONG_STAGING_PASSWORD@postgres:5432/skyarc_atlas_staging

# Fresh staging: apply SQL migrations via API entrypoint, then seed (see runbook).
# DATABASE_BOOTSTRAP=always   # only on first empty DB
DATABASE_BOOTSTRAP=never

# --- JWT (staging-only secrets, min 32 chars) ---
JWT_ACCESS_SECRET=REPLACE_STAGING_JWT_ACCESS_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_STAGING_JWT_REFRESH_MIN_32_CHARS

# --- Public URLs (HTTPS) ---
# Vercel staging frontend (exact origin for CORS + password reset links)
WEB_APP_URL=https://YOUR_PROJECT.vercel.app
# Comma-separated; include exact preview URL and optional wildcard previews
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app,https://*.vercel.app

# --- Host publish (loopback only — nginx terminates TLS) ---
API_HOST_PORT=3101
ORBIT_HOST_PORT=3102
PULSE_HOST_PORT=3103
BRIDGE_HOST_PORT=3104

# --- Service tokens (generate unique staging values) ---
ORBIT_SERVICE_TOKEN=REPLACE_STAGING_ORBIT_SERVICE_TOKEN_32
ORBIT_WEBHOOK_SECRET=REPLACE_STAGING_ORBIT_WEBHOOK_SECRET_32
PULSE_SERVICE_TOKEN=REPLACE_STAGING_PULSE_ATLAS_SHARED_TOKEN_32
BRIDGE_SERVICE_TOKEN=REPLACE_STAGING_BRIDGE_SERVICE_TOKEN_32

# --- Internal docker DNS (defaults OK) ---
ATLAS_INTERNAL_URL=http://api:3001
BRIDGE_INTERNAL_URL=http://bridge:3004
ORBIT_CLOUD_URL=http://orbit-cloud:3002

# --- Staging MQTT (Mosquitto on compose network; not exposed publicly) ---
ORBIT_MQTT_URL=mqtt://mosquitto:1883
ORBIT_MQTT_USERNAME=orbit-staging-consumer
ORBIT_MQTT_PASSWORD=REPLACE_STAGING_MQTT_PASSWORD

# --- Object storage (optional; mock when R2 empty) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skyarc-atlas-staging
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- AI (stub on staging) ---
AI_PROVIDER=stub

# --- Live integrations DISABLED on staging ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # if testing controlled OIDC only, use staging callback via HTTPS API host
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Seed guard ---
STAGING_SEED_CONFIRM=1
STAGING_USER_PASSWORD=StagingTest2026!
