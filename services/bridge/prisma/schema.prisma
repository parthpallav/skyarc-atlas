generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("BRIDGE_DATABASE_URL")
  schemas  = ["bridge"]
}

model OutboundMessage {
  id                String    @id @default(uuid()) @db.Uuid
  channel           String
  toE164            String
  bodyPreview       String?
  /// Legacy coarse status
  status            String    @default("queued")
  /// queued | submitted | delivered | read | failed | dry_run | partial
  deliveryStatus    String    @default("queued")
  providerMessageId String?
  idempotencyKey    String?   @unique
  attemptCount      Int       @default(0)
  nextRetryAt       DateTime?
  payloadJson       Json      @default("{}")
  receiptJson       Json      @default("{}")
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([channel, createdAt(sort: Desc)])
  @@index([deliveryStatus, nextRetryAt])
  @@index([providerMessageId])
  @@schema("bridge")
}

model InboundEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  channel            String
  payloadJson        Json
  providerEventId    String?  @unique
  signatureVerified  Boolean  @default(false)
  processed          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([channel, createdAt(sort: Desc)])
  @@schema("bridge")
}
