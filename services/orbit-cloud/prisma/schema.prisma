generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ORBIT_DATABASE_URL")
  // Isolate Orbit tables so db push never drops Atlas public tables when
  // ORBIT_DATABASE_URL points at the shared skyarc_atlas database.
  schemas  = ["orbit"]
}

model OrbitDevice {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String
  atlasScreenId     String    @db.Uuid
  skyarcScreenCode  String
  /// Physical identity from Lunar firmware (e.g. ORBIT-0001). Never changes.
  physicalDeviceId  String?   @unique
  /// MQTT username proposal (orbit_ORBIT0001); optional until broker provisioning.
  mqttUsername      String?
  deviceType        String
  status            String    @default("pending")
  credentialHash    String?
  credentialVersion Int       @default(0)
  revokedAt         DateTime?
  lastSeenAt        DateTime?
  health            String    @default("unknown")
  firmwareVersion   String?
  /// Last applied integer configVersion (Lunar). Ignore inbound ≤ current.
  appliedConfigVersion Int    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  claims       ClaimCode[]
  telemetry    OrbitTelemetry[]
  state        OrbitDeviceState?
  outbox       OrbitEventOutbox[]
  capabilities OrbitDeviceCapability[]
  rawEvents    OrbitRawEvent[]
  measurements OrbitMeasurement[]
  measureState OrbitMeasurementState[]
  incidents    OrbitIncident[]
  aggregates   OrbitAggregate[]
  coverageGaps OrbitCoverageGap[]
  inbox        OrbitIngestInbox[]
  failures     OrbitIngestFailure[]
  commands     OrbitCommand[]
  commandAcks  OrbitCommandAck[]
  configs      OrbitDeviceConfig[]

  @@index([tenantId, atlasScreenId])
  @@index([skyarcScreenCode])
  @@index([tenantId, status])
  @@schema("orbit")
}

model ClaimCode {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@schema("orbit")
}

/// Legacy sample store — retained for foundation heartbeat path.
model OrbitTelemetry {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @db.Uuid
  observedAt  DateTime
  kind        String
  payloadJson Json
  createdAt   DateTime @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, observedAt(sort: Desc)])
  @@schema("orbit")
}

model OrbitDeviceState {
  deviceId           String    @id @db.Uuid
  /// Connectivity from fresh heartbeats only — not screen power or playback.
  online             Boolean   @default(false)
  health             String    @default("unknown")
  lastHeartbeatAt    DateTime?
  sensorHealth       String    @default("unknown")
  screenPower        String    @default("unknown")
  playbackVerified   String    @default("unknown")
  summaryJson        Json      @default("{}")
  updatedAt          DateTime  @updatedAt

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@schema("orbit")
}

model OrbitEventOutbox {
  eventId     String    @id @db.Uuid
  deviceId    String    @db.Uuid
  eventType   String
  version     Int       @default(1)
  tenantId    String
  payloadJson Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, createdAt])
  @@schema("orbit")
}

/// Durable MQTT/HTTPS handoff. Broker ACK only after inbox insert.
/// Deduplicate messageId within device context (Lunar Spec §7).
model OrbitIngestInbox {
  id           String    @id @default(uuid()) @db.Uuid
  /// Idempotency key: Lunar messageId or internal 7b eventId
  eventId      String
  deviceId     String    @db.Uuid
  tenantId     String
  topic        String?
  channel      String?
  schemaFamily String    @default("7b.v1") // "lunar.v1" | "7b.v1"
  payloadJson  Json
  /// Original Lunar envelope when schemaFamily=lunar.v1 (investigation)
  envelopeJson Json?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  processError String?

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, eventId])
  @@index([processedAt, receivedAt])
  @@index([deviceId, receivedAt])
  @@schema("orbit")
}

model OrbitIngestFailure {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String?  @db.Uuid
  tenantId    String?
  topic       String?
  reason      String
  payloadPreview String?
  receivedAt  DateTime @default(now())

  device OrbitDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@schema("orbit")
}

/// Deduplicated raw events (short retention). eventId = messageId (Lunar) or UUID (7b).
model OrbitRawEvent {
  eventId          String   @id
  deviceId         String   @db.Uuid
  tenantId         String
  bootId           String
  sessionId        String
  sequence         Int
  observedAt       DateTime
  receivedAt       DateTime
  firmwareVersion  String
  measurementType  String
  schemaVersion    String
  payloadJson      Json
  /// Original wire envelope when available
  envelopeJson     Json?
  createdAt        DateTime @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, observedAt])
  @@index([tenantId, observedAt])
  @@index([receivedAt])
  @@schema("orbit")
}

/// Queryable normalized measurements.
model OrbitMeasurement {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @unique
  deviceId        String   @db.Uuid
  tenantId        String
  measurementType String
  observedAt      DateTime
  receivedAt      DateTime
  numericValue    Float?
  textValue       String?
  unit            String?
  confidence      Float?
  qualityFlagsJson Json    @default("[]")
  typedValuesJson Json     @default("{}")
  capabilityStatus String  @default("unknown")
  createdAt       DateTime @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, measurementType, observedAt])
  @@index([tenantId, measurementType, observedAt])
  @@schema("orbit")
}

/// Latest state per device + measurement type.
model OrbitMeasurementState {
  id              String   @id @default(uuid()) @db.Uuid
  deviceId        String   @db.Uuid
  measurementType String
  observedAt      DateTime
  receivedAt      DateTime
  numericValue    Float?
  textValue       String?
  unit            String?
  summaryJson     Json     @default("{}")
  updatedAt       DateTime @updatedAt

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, measurementType])
  @@index([deviceId])
  @@schema("orbit")
}

model OrbitDeviceCapability {
  id               String   @id @default(uuid()) @db.Uuid
  deviceId         String   @db.Uuid
  version          Int
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  capabilitiesJson Json
  createdAt        DateTime @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, effectiveFrom])
  @@schema("orbit")
}

model OrbitIncident {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @db.Uuid
  tenantId        String
  kind            String
  severity        String    @default("info")
  startedAt       DateTime
  endedAt         DateTime?
  evidenceJson    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@index([tenantId, kind, startedAt])
  @@schema("orbit")
}

model OrbitAggregate {
  id              String   @id @default(uuid()) @db.Uuid
  deviceId        String   @db.Uuid
  tenantId        String
  measurementType String
  bucket          String
  bucketStart     DateTime
  sampleCount     Int      @default(0)
  minValue        Float?
  maxValue        Float?
  avgValue        Float?
  sumValue        Float?
  missingFlag     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, measurementType, bucket, bucketStart])
  @@index([tenantId, bucket, bucketStart])
  @@schema("orbit")
}

model OrbitCoverageGap {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  tenantId   String
  gapStart   DateTime
  gapEnd     DateTime
  reason     String
  createdAt  DateTime @default(now())

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, gapStart])
  @@schema("orbit")
}

/// Atlas→device command history. PUBACK ≠ execution; correlate via commandId.
model OrbitCommand {
  id              String    @id @default(uuid()) @db.Uuid
  commandId       String
  deviceId        String    @db.Uuid
  tenantId        String
  command         String
  parametersJson  Json      @default("{}")
  messageId       String
  /// accepted | executing | completed | failed | rejected | expired
  outcome         String    @default("accepted")
  expiresAt       DateTime?
  issuedAt        DateTime  @default(now())
  completedAt     DateTime?
  /// For restart: COMPLETED expected after boot with same commandId
  awaitBootCompletion Boolean @default(false)
  detailJson      Json      @default("{}")

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  acks   OrbitCommandAck[]

  @@unique([deviceId, commandId])
  @@index([tenantId, issuedAt])
  @@index([outcome, issuedAt])
  @@schema("orbit")
}

model OrbitCommandAck {
  id          String   @id @default(uuid()) @db.Uuid
  commandId   String
  deviceId    String   @db.Uuid
  messageId   String
  status      String
  observedAt  DateTime
  receivedAt  DateTime @default(now())
  payloadJson Json     @default("{}")
  commandRowId String? @db.Uuid

  device  OrbitDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command OrbitCommand? @relation(fields: [commandRowId], references: [id], onDelete: SetNull)

  @@unique([deviceId, messageId])
  @@index([deviceId, commandId, receivedAt])
  @@schema("orbit")
}

/// Config versions pushed to device. Ignore apply of version ≤ current.
model OrbitDeviceConfig {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @db.Uuid
  configVersion Int
  configJson    Json
  messageId     String
  issuedAt      DateTime @default(now())
  /// pending | applied | rejected_stale | invalid
  status        String   @default("pending")
  appliedAt     DateTime?

  device OrbitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, configVersion])
  @@index([deviceId, issuedAt])
  @@schema("orbit")
}
