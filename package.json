{
  "name": "skyarc-atlas",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed-full.ts",
    "db:seed:basic": "tsx prisma/seed.ts",
    "db:seed:full": "tsx prisma/seed-full.ts",
    "db:seed:rajkot": "tsx prisma/seed-rajkot-hoardings.ts",
    "db:seed:campaign": "tsx prisma/seed-demo-campaign.ts",
    "db:seed:media-planning": "tsx prisma/seed-media-planning.ts",
    "db:postgis": "tsx prisma/apply-postgis.ts",
    "db:setup": "prisma db push && tsx prisma/apply-postgis.ts && tsx prisma/seed-full.ts",
    "openapi:generate": "pnpm --filter @skyarc/validation run build && pnpm --filter @skyarc/api run openapi:generate"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@types/node": "^22.10.2",
    "argon2": "^0.41.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
