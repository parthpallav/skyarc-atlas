# Database (Supabase Postgres)
# Session / persistent (port 5432) — use for VPS API, migrations, seeds, and all runtime queries.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) — serverless only. Do NOT use on VPS API.
# DATABASE_USE_POOLER=true
# Ping DB every 4 min to avoid idle disconnects (default on)
# DATABASE_KEEPALIVE=false
# In-memory location list/detail cache (seconds, default 300). Set false to disable.
# LOCATION_CACHE_TTL_SECONDS=300
# LOCATION_CACHE_ENABLED=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skyarc-atlas
# Leave blank until R2 is configured (mock storage used when empty)
R2_ENDPOINT=
R2_PUBLIC_URL=

# AI
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

# Google Maps — optional, for Rajkot hoarding seed Street View images
# Enable Street View Static API + Maps Static API in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# API
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Web (Phase 3)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mobile (Phase 2)
# Physical phone: use your Mac LAN IP (ipconfig getifaddr en0), not localhost
EXPO_PUBLIC_API_URL=http://192.168.0.4:3001
