# Staging (isolated VPS + Vercel): see `docs/deploy/env.staging.example` and `docs/deploy/STAGING_DEPLOY_RUNBOOK.md`

# Database — self-hosted PostGIS on VPS (docker compose postgres service)
POSTGRES_USER=skyarc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=skyarc_atlas
DATABASE_URL=postgresql://skyarc:change-me-strong-password@postgres:5432/skyarc_atlas
# Local dev (docker-compose.dev.yml): postgresql://skyarc:skyarc@localhost:5432/skyarc_atlas
# In-memory location list/detail cache (seconds, default 300). Set false to disable.
# LOCATION_CACHE_TTL_SECONDS=300
# LOCATION_CACHE_ENABLED=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skyarc-atlas
# Leave blank until R2 is configured (mock storage used when empty)
R2_ENDPOINT=
R2_PUBLIC_URL=

# AI
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

# Google Maps — optional, for Rajkot hoarding seed Street View images
# Enable Street View Static API + Maps Static API in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# API (container always listens on 3001; host publish via API_HOST_PORT)
API_HOST_PORT=3001
PORT=3001
NODE_ENV=development
# Comma-separated origins. Supports exact entries and one * wildcard segment
# (e.g. https://*.vercel.app) so new preview deployments do not need code edits.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,https://*.vercel.app,https://atlas.skyarcads.com
# Public web app URL for password-reset links (never the API :3001 host).
WEB_APP_URL=https://atlas.skyarcads.com

# Web (Phase 3)
# Browser uses same-origin /api (proxied by apps/web). Set API_PROXY_TARGET on Vercel
# to the Atlas API origin — required at runtime, never hardcode a VPS hostname in repo.
# API_PROXY_TARGET=http://YOUR_VPS_HOST:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Demo role buttons on /login. Local default is on when NODE_ENV is not production.
# Production must leave this unset or false — never ship test logins.
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Mobile (Phase 2)
# Local dev on physical phone: use your Mac LAN IP (ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://192.168.0.4:3001
# Production EAS builds (HTTPS — same proxy as web):
# EXPO_PUBLIC_API_URL=https://skyarc-atlas.vercel.app

# Orbit Cloud (optional — Atlas works without it)
ORBIT_CLOUD_URL=http://127.0.0.1:3002
ORBIT_SERVICE_TOKEN=change-me-orbit-service-token-min-16
ORBIT_WEBHOOK_SECRET=change-me-orbit-webhook-secret-min
ORBIT_DATABASE_URL=postgresql://skyarc:change-me-strong-password@postgres:5432/skyarc_atlas
ORBIT_HOST_PORT=3002
ORBIT_PORT=3002
# Docker DNS — override only if the compose service is renamed
ATLAS_INTERNAL_URL=http://api:3001

# Web — Orbit tab on location detail (hidden unless true)
# NEXT_PUBLIC_ORBIT_UI=true

# Pulse + Bridge (Excel export, WhatsApp share — optional; Atlas core unchanged)
PULSE_HOST_PORT=3003
PULSE_DATABASE_URL=postgresql://skyarc:change-me-strong-password@postgres:5432/skyarc_atlas
BRIDGE_HOST_PORT=3004
BRIDGE_DATABASE_URL=postgresql://skyarc:change-me-strong-password@postgres:5432/skyarc_atlas
BRIDGE_SERVICE_TOKEN=change-me-bridge-service-token-min-16
BRIDGE_INTERNAL_URL=http://bridge:3004
# Must match Pulse ATLAS_SERVICE_TOKEN for Bridge→Atlas WhatsApp link resolve
PULSE_SERVICE_TOKEN=change-me-pulse-atlas-shared-token-min-16
# Web: proxy /pulse/* to Pulse (Vercel runtime env)
# PULSE_PROXY_TARGET=http://YOUR_VPS_HOST:3003
# NEXT_PUBLIC_PULSE_URL=  # optional; defaults to /pulse in production browser
# WhatsApp Cloud API (Bridge — dry-run when unset)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
