model ExecutionTask {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?             @db.Uuid
  campaignId           String              @db.Uuid
  bookingId            String              @db.Uuid
  bookingItemId        String?             @db.Uuid
  /// bookingItemId or "campaign" + kind — unique with bookingId for idempotent seed
  dedupeKey            String
  kind                 ExecutionTaskKind
  status               ExecutionTaskStatus @default(PENDING)
  templateKey          String
  title                String
  ownerUserId          String?             @db.Uuid
  dueAt                DateTime?
  dependsOnTaskId      String?             @db.Uuid
  checklistJson        Json                @default("[]")
  attachmentsJson      Json                @default("[]")
  blockedReason        String?
  sortOrder            Int                 @default(0)
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  booking     Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem?          @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  dependsOn   ExecutionTask?        @relation("TaskDeps", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  dependents  ExecutionTask[]       @relation("TaskDeps")
  history     ExecutionTaskHistory[]
  proofs      ProofRecord[]

  @@unique([bookingId, dedupeKey])
  @@index([campaignId, status])
  @@index([bookingId, status])
  @@index([dueAt, status])
  @@index([ownerUserId])
}

model ExecutionTaskHistory {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  fromStatus String?
  toStatus  String
  actorUserId String? @db.Uuid
  note      String?
  patchJson Json     @default("{}")
  createdAt DateTime @default(now())

  task ExecutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model CreativeVersion {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?                  @db.Uuid
  campaignId           String                   @db.Uuid
  revisionNumber       Int
  status               CreativeVersionStatus    @default(DRAFT)
  label                String?
  r2Key                String
  contentType          String
  byteSize             Int?
  checksumSha256       String?
  widthPx              Int?
  heightPx             Int?
  durationMs           Int?
  cmsHandoffStatus     CreativeCmsHandoffStatus @default(NOT_REQUIRED)
  cmsHandoffNote       String?
  cmsHandoffAt         DateTime?
  submittedAt          DateTime?
  submittedByUserId    String?                  @db.Uuid
  reviewedAt           DateTime?
  reviewedByUserId     String?                  @db.Uuid
  rejectReason         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  campaign Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bookingItems CreativeBookingItem[]

  @@unique([campaignId, revisionNumber])
  @@index([campaignId, status])
}

model CreativeBookingItem {
  id                String @id @default(uuid()) @db.Uuid
  creativeVersionId String @db.Uuid
  bookingItemId     String @db.Uuid

  creative    CreativeVersion @relation(fields: [creativeVersionId], references: [id], onDelete: Cascade)
  bookingItem BookingItem     @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@unique([creativeVersionId, bookingItemId])
  @@index([bookingItemId])
}

model ProofRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?           @db.Uuid
  campaignId           String            @db.Uuid
  bookingId            String?           @db.Uuid
  bookingItemId        String?           @db.Uuid
  locationId           String            @db.Uuid
  locationAssetId      String            @db.Uuid
  executionTaskId      String?           @db.Uuid
  kind                 ProofKind         @default(LIVE_ON_SITE)
  reviewStatus         ProofReviewStatus @default(PENDING_REVIEW)
  /// Supplied evidence only — not guaranteed authenticity.
  capturedAt           DateTime?
  uploadedAt           DateTime          @default(now())
  capturedLat          Float?
  capturedLng          Float?
  capturedAccuracyM    Float?
  submitterUserId      String?           @db.Uuid
  provenanceNote       String?
  reviewedAt           DateTime?
  reviewedByUserId     String?           @db.Uuid
  rejectReason         String?
  replacesProofId      String?           @db.Uuid
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bookingItem BookingItem?   @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  task        ExecutionTask? @relation(fields: [executionTaskId], references: [id], onDelete: SetNull)

  @@index([campaignId, reviewStatus])
  @@index([bookingItemId])
  @@index([executionTaskId])
  @@index([locationAssetId])
}

model InvoiceNumberSequence {
  id                   String @id @default(uuid()) @db.Uuid
  tenantOrganizationId String @db.Uuid
  prefix               String @default("INV")
  nextNumber           Int    @default(1)

  @@unique([tenantOrganizationId, prefix])
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?       @db.Uuid
  campaignId           String        @db.Uuid
  bookingId            String?       @db.Uuid
  quoteRevisionId      String?       @db.Uuid
  invoiceNumber        String?       @unique
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("INR")
  subtotalMinor        Int
  taxMinor             Int           @default(0)
  totalMinor           Int
  amountPaidMinor      Int           @default(0)
  amountCreditedMinor  Int           @default(0)
  /// Frozen customer-safe commercial snapshot at issue time.
  commercialSnapshotJson Json        @default("{}")
  paymentTerms         String?
  dueAt                DateTime?
  issuedAt             DateTime?
  voidedAt             DateTime?
  createdByUserId      String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  booking  Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  quote    QuoteRevision? @relation(fields: [quoteRevisionId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments InvoicePayment[]
  creditNotes CreditNote[]

  @@index([campaignId, status])
  @@index([bookingId])
  @@index([tenantOrganizationId, status])
  @@index([dueAt, status])
  @@index([quoteRevisionId])
}

model InvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @db.Uuid
  kind        InvoiceLineKind @default(MEDIA)
  description String
  inventoryId String?         @db.Uuid
  quantity    Int             @default(1)
  unitMinor   Int
  amountMinor Int
  taxMinor    Int             @default(0)
  sortOrder   Int             @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePayment {
  id               String               @id @default(uuid()) @db.Uuid
  invoiceId        String               @db.Uuid
  amountMinor      Int
  currency         String               @default("INR")
  method           InvoicePaymentMethod @default(MANUAL)
  status           InvoicePaymentStatus @default(RECORDED)
  reference        String?
  recordedAt       DateTime             @default(now())
  recordedByUserId String?              @db.Uuid
  idempotencyKey   String?              @unique
  provider         String?
  providerIntentId String?
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  audits  InvoicePaymentAudit[]

  @@index([invoiceId, status])
}

model InvoicePaymentAudit {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  actorUserId String? @db.Uuid
  action    String
  detailJson Json    @default("{}")
  createdAt DateTime @default(now())

  payment InvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model CreditNote {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?         @db.Uuid
  invoiceId            String          @db.Uuid
  creditNumber         String?         @unique
  status               CreditNoteStatus @default(DRAFT)
  amountMinor          Int
  currency             String          @default("INR")
  reason               String
  snapshotJson         Json            @default("{}")
  issuedAt             DateTime?
  createdByUserId      String?         @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model VendorPurchaseOrder {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?       @db.Uuid
  campaignId           String?       @db.Uuid
  vendorOrganizationId String        @db.Uuid
  poNumber             String?
  status               VendorPoStatus @default(DRAFT)
  currency             String        @default("INR")
  expectedCostMinor    Int           @default(0)
  approvedCommitmentMinor Int        @default(0)
  notes                String?
  createdByUserId      String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  bills VendorBill[]
  expenses CampaignExpense[]

  @@index([campaignId])
  @@index([vendorOrganizationId, status])
  @@index([tenantOrganizationId])
}

model VendorBill {
  id                   String          @id @default(uuid()) @db.Uuid
  purchaseOrderId      String?         @db.Uuid
  tenantOrganizationId String?         @db.Uuid
  vendorOrganizationId String          @db.Uuid
  billNumber           String?
  status               VendorBillStatus @default(DRAFT)
  currency             String          @default("INR")
  incurredMinor        Int             @default(0)
  paidMinor            Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  purchaseOrder VendorPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  expenses CampaignExpense[]

  @@index([vendorOrganizationId, status])
  @@index([purchaseOrderId])
}

model CampaignExpense {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?               @db.Uuid
  campaignId           String                @db.Uuid
  purchaseOrderId      String?               @db.Uuid
  vendorBillId         String?               @db.Uuid
  /// Prevents double-attribution of the same external cost key
  attributionKey       String
  label                String
  status               CampaignExpenseStatus @default(EXPECTED)
  currency             String                @default("INR")
  expectedMinor        Int                   @default(0)
  committedMinor       Int                   @default(0)
  incurredMinor        Int                   @default(0)
  paidMinor            Int                   @default(0)
  costMissing          Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  campaign      Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  purchaseOrder VendorPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  vendorBill    VendorBill?          @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)

  @@unique([campaignId, attributionKey])
  @@index([campaignId, status])
  @@index([tenantOrganizationId])
}

model ReminderJob {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?           @db.Uuid
  campaignId           String?           @db.Uuid
  kind                 ReminderKind
  status               ReminderJobStatus @default(PENDING)
  dueAt                DateTime
  payloadJson          Json              @default("{}")
  deliveryChannel      String?           // bridge | email | none
  deliveryStatusNote   String?
  sentAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([campaignId])
}

model AccountingExportBatch {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?                @db.Uuid
  kind                 AccountingExportKind   @default(FILE_EXPORT)
  status               AccountingExportStatus @default(DRAFT)
  adapter              String                 @default("tally-file")
  stableBatchKey       String                 @unique
  mappingValidationJson Json                  @default("{}")
  reconciliationStatus String                 @default("UNRECONCILED")
  payloadJson          Json                   @default("{}")
  exportedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([tenantOrganizationId, status])
}




enum WhatsAppConfirmAction {
  RESERVE_INVENTORY
  ACCEPT_QUOTE
  AMEND_BOOKING
  CANCEL_BOOKING
  VENDOR_APPROVE
}

/// Verified WhatsApp channel ↔ Atlas user+tenant. Phone alone never grants access.
model WhatsAppAccountLink {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tenantOrganizationId String    @db.Uuid
  phoneE164            String
  verifiedAt           DateTime
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([phoneE164, revokedAt])
  @@index([userId, revokedAt])
  @@index([tenantOrganizationId])
}

model WhatsAppLinkChallenge {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tenantOrganizationId String    @db.Uuid
  phoneE164            String
  tokenHash            String    @unique
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([userId, expiresAt])
}

model WhatsAppActionConfirmation {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @db.Uuid
  tenantOrganizationId String?                @db.Uuid
  action               WhatsAppConfirmAction
  payloadJson          Json                   @default("{}")
  fingerprint          String
  tokenHash            String                 @unique
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime               @default(now())

  @@index([userId, expiresAt])
  @@index([fingerprint])
}




enum CommercialRecommendationKind {
  CONTINUITY_REPLACEMENT
  FILL_RATE_PACKAGE
}

enum CommercialRecommendationStatus {
  OPEN
  APPROVED
  DISMISSED
  APPLIED
  EXPIRED
  SUPERSEDED
  FAILED
}

enum RecommendationMethod {
  DETERMINISTIC_RULE
  HEURISTIC
}

/// Phase 7A continuity / fill-rate recommendations. Not a quote or reservation ledger.
model CommercialRecommendation {
  id                   String                          @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?                         @db.Uuid
  kind                 CommercialRecommendationKind
  status               CommercialRecommendationStatus  @default(OPEN)
  method               RecommendationMethod            @default(DETERMINISTIC_RULE)
  ruleVersion          String                          @default("7a.v1")
  /// Dedupes repeated triggers (e.g. bookingItem:reject:<id>)
  triggerKey           String
  triggerType          String
  campaignId           String?                         @db.Uuid
  bookingId            String?                         @db.Uuid
  bookingItemId        String?                         @db.Uuid
  observedAt           DateTime                        @default(now())
  expiresAt            DateTime
  inputSnapshotJson    Json                            @default("{}")
  suggestionsJson      Json                            @default("[]")
  explanation          String?
  freshnessLabel       String                          @default("fresh")
  pricingAvailable     Boolean                         @default(true)
  costDataComplete     Boolean                         @default(false)
  marginSuppressed     Boolean                         @default(false)
  reviewedAt           DateTime?
  reviewedByUserId     String?                         @db.Uuid
  appliedChangeJson    Json                            @default("{}")
  actionHistoryJson    Json                            @default("[]")
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([triggerKey])
  @@index([tenantOrganizationId, status])
  @@index([campaignId, status])
  @@index([kind, status, expiresAt])
  @@index([bookingId])
}


/// Ledger for prisma/migrations/*.sql — maintained by apply-sql-migrations.sh (not Prisma Migrate).
model SkyarcSqlMigration {
  id        String   @id
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("_skyarc_sql_migrations")
}
