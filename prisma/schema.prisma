generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MEDIA_PLANNER
  FIELD_OPERATOR
  VENDOR
  SALES
  VIEWER
  VENDOR_ADMIN
  VENDOR_OPS
  CLIENT_VIEWER
}

enum OrganizationType {
  INTERNAL
  VENDOR
  CLIENT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum Provenance {
  USER_PROVIDED
  OBSERVED
  DERIVED
  ESTIMATED
  AI_INFERRED
  UNKNOWN
}

enum AssetKind {
  PHOTO
  APPROACH_VIDEO
  REVERSE_PHOTO
  VOICE_NOTE
  CAMPAIGN_LIVE_PROOF
  OTHER
}

enum PhotoView {
  FRONT
  APPROACH
  LEFT
  RIGHT
  REVERSE
  SURROUNDING
  OTHER
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
  RETRYING
}

enum SurveyStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SUBMITTED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  UNAVAILABLE
  UNKNOWN
}

enum ScoreStatus {
  INCOMPLETE
  COMPUTED
  STALE
}

enum AIAnalysisStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AIOperation {
  LOCATION_IMAGE_ANALYSIS
  LOCATION_SUMMARIZATION
  CAMPAIGN_BRIEF_PARSE
  ADVERTISER_CLASSIFY
  MEDIA_PLAN_EXPLAIN
}

enum ParseStatus {
  PENDING
  PARSED
  FAILED
}

enum MediaPlanStatus {
  DRAFT
  PROPOSED
  APPROVED
  REJECTED
}

enum MediaPlanItemApproval {
  PENDING
  APPROVED
  REJECTED
}

/// Campaign operational lifecycle (distinct from media-plan status).
enum CampaignLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AvailabilityWindowStatus {
  AVAILABLE
  BLOCKED
  HELD
  BOOKED
}

/// Commercial / ops booking header (capacity stays on AvailabilityWindow).
enum BookingStatus {
  REQUESTED
  HELD
  PENDING_VENDOR_APPROVAL
  PARTIALLY_APPROVED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum BookingItemStatus {
  REQUESTED
  HELD
  PENDING_VENDOR_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
  EXPIRED
  CANCELLED
}

/// Separate from booking lifecycle — payment integration may be UNAVAILABLE.
enum BookingPaymentStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  UNAVAILABLE
}

/// Separate from booking and payment — campaign execution tracking.
enum BookingExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
}


enum QuoteRevisionStatus {
  DRAFT
  ISSUED
  ACCEPTED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  ISSUED
  ACCEPTED
  SUPERSEDED
  EXPIRED
  CANCELLED
}

enum ScenarioKind {
  COVERAGE
  CONCENTRATION
}


model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  name           String
  role           UserRole
  organizationId String?   @db.Uuid
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  refreshTokens RefreshToken[]
  locations     Location[]

  @@index([organizationId])
}

model Organization {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @unique
  type           OrganizationType
  status         OrganizationStatus @default(ACTIVE)
  commercialJson Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  members   User[]
  locations Location[]
  bookings  Booking[] @relation("BookingTenantOrg")

  @@index([type, status])
}

model PlatformConfig {
  id        String   @id @default("default")
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Location {
  id              String       @id @default(uuid()) @db.Uuid
  skyarcSiteCode  String?      @unique
  vendorMediaCode String?
  name            String
  latitude        Float
  longitude       Float
  /** PostGIS point maintained by trigger from lat/lng — not queried via Prisma Client. */
  geom            Unsupported("geography(Point,4326)")?
  accuracyM       Float?
  capturedAt      DateTime?
  address         String?
  road            String?
  roadType        String?
  junction        String?
  city            String?
  district        String?
  state           String?
  orientationDeg  Float?
  mountingType    String?
  mountingNotes   String?
  surveyStatus    SurveyStatus @default(DRAFT)
  archivedAt      DateTime?
  organizationId  String?      @db.Uuid
  commercialJson  Json         @default("{}")
  skyarcCommercialJson Json    @default("{}")
  /** Site-specific Skyarc Index scenario, basis notes, optional weight overrides. */
  scoringJson     Json         @default("{}")
  createdByUserId String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation(fields: [createdByUserId], references: [id])
  assets       LocationAsset[]
  screens      Screen[]
  attributes   LocationAttribute[]
  scores       LocationScore[]
  survey       LocationSurvey?
  analyses     AIAnalysis[]
  recommendations Recommendation[]

  @@index([createdByUserId])
  @@index([organizationId])
  @@index([latitude, longitude])
  @@index([skyarcSiteCode])
  @@index([vendorMediaCode])
  @@index([city])
  @@index([district])
  @@index([state])
}

model LocationSurvey {
  id                  String   @id @default(uuid()) @db.Uuid
  locationId          String   @unique @db.Uuid
  checklist           Json     @default("{}")
  voiceNoteAssetId    String?  @db.Uuid
  freeTextObservation String?
  syncState           String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model LocationAsset {
  id             String       @id @default(uuid()) @db.Uuid
  locationId     String       @db.Uuid
  /** When set with kind CAMPAIGN_LIVE_PROOF, photo documents a live campaign on this site. */
  campaignId     String?      @db.Uuid
  kind           AssetKind
  view           PhotoView    @default(OTHER)
  r2Key          String
  contentType    String
  byteSize       Int?
  checksumSha256 String?
  width          Int?
  height         Int?
  durationMs     Int?
  capturedAt     DateTime?
  capturedLat    Float?
  capturedLng    Float?
  uploadStatus   UploadStatus @default(PENDING)
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  location  Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  campaign  Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  evidences AIAnalysisEvidence[]

  @@index([locationId, kind])
  @@index([locationId, view])
  @@index([campaignId])
}

model Screen {
  id                 String          @id @default(uuid()) @db.Uuid
  locationId         String          @db.Uuid
  /// Skyarc-owned public screen identity (e.g. SKY-RAJ-001 or SKY-RAJ-001-F2).
  skyarcScreenCode   String?         @unique
  label              String
  inventoryStatus    InventoryStatus @default(UNKNOWN)
  operatingHoursJson Json?
  loopDurationSec    Int?
  slotDurationSec    Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  location      Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  specification ScreenSpecification?
  inventories   Inventory[]
  devices       Device[]
  externalIds   ScreenExternalId[]
}

/// External provider ids mapped to a Skyarc screen. Never the primary screen identity.
model ScreenExternalId {
  id         String   @id @default(uuid()) @db.Uuid
  screenId   String   @db.Uuid
  provider   String
  idType     String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([provider, idType, externalId])
  @@index([screenId, provider])
}

/// Atlas-side device association. Credentials and raw telemetry live in Orbit Cloud.
model Device {
  id             String    @id @default(uuid()) @db.Uuid
  screenId       String    @db.Uuid
  organizationId String?   @db.Uuid
  provider       String
  deviceType     String
  externalId     String
  status         String    @default("pending")
  summaryJson    Json      @default("{}")
  lastEventAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([screenId])
}

/// Idempotent receipts for Orbit → Atlas domain events.
model OrbitEventReceipt {
  eventId   String   @id @db.Uuid
  eventType String
  receivedAt DateTime @default(now())
}

model ScreenSpecification {
  id              String   @id @default(uuid()) @db.Uuid
  screenId        String   @unique @db.Uuid
  widthMm         Float?
  heightMm        Float?
  resolutionW     Int?
  resolutionH     Int?
  aspectRatio     String?
  orientation     String?
  mountingHeightM Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
}

model LocationAttribute {
  id           String     @id @default(uuid()) @db.Uuid
  locationId   String     @db.Uuid
  key          String
  valueJson    Json
  unit         String?
  provenance   Provenance @default(UNKNOWN)
  confidence   Float?
  source       String?
  model        String?
  evidenceJson Json?
  observedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, key])
}

model ScoringConfig {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  isActive         Boolean  @default(false)
  weightsJson      Json
  /** Customer-facing methodology / trust copy for Skyarc Index. */
  methodologyJson  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scores LocationScore[]
}

model LocationScore {
  id                String      @id @default(uuid()) @db.Uuid
  locationId        String      @db.Uuid
  scoringConfigId   String      @db.Uuid
  overallScore      Float
  overallConfidence Float
  status            ScoreStatus @default(INCOMPLETE)
  componentsJson    Json
  computedAt        DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  scoringConfig ScoringConfig @relation(fields: [scoringConfigId], references: [id])

  @@index([locationId])
}

model AIAnalysis {
  id          String           @id @default(uuid()) @db.Uuid
  operation   AIOperation
  status      AIAnalysisStatus @default(QUEUED)
  provider    String?
  model       String?
  inputHash   String?
  latencyMs   Int?
  confidence  Float?
  errorCode   String?
  outputJson  Json?
  locationId  String?          @db.Uuid
  campaignId  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  location   Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  campaign   Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  evidences  AIAnalysisEvidence[]
  recommendations Recommendation[]

  @@index([status, createdAt])
}

model AIAnalysisEvidence {
  id         String  @id @default(uuid()) @db.Uuid
  analysisId String  @db.Uuid
  assetId    String? @db.Uuid
  label      String
  excerpt    String?
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analysis AIAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  asset    LocationAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model AdvertiserCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  advertisers Advertiser[]
}

model Advertiser {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  categoryId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category AdvertiserCategory? @relation(fields: [categoryId], references: [id])
  campaigns Campaign[]
}

model Campaign {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String
  advertiserId    String                  @db.Uuid
  startDate       DateTime?
  endDate         DateTime?
  /// Operational status: PENDING_APPROVAL while site requests open; ACTIVE when all approved for flight.
  lifecycleStatus CampaignLifecycleStatus @default(DRAFT)
  /// When set by Skyarc planner/admin, brand/client may send site requests to media owners.
  readyForSiteRequestsAt DateTime?
  createdByUserId String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  advertiser      Advertiser       @relation(fields: [advertiserId], references: [id])
  brief           CampaignBrief?
  mediaPlans      MediaPlan[]
  bookings        Booking[]
  quotes          QuoteRevision[]
  proposals       ProposalRevision[]
  analyses        AIAnalysis[]
  recommendations Recommendation[]
  liveProofAssets LocationAsset[]
  availabilityWindows AvailabilityWindow[]
  executionTasks  ExecutionTask[]
  creativeVersions CreativeVersion[]
  proofRecords    ProofRecord[]
  invoices        Invoice[]
  campaignExpenses CampaignExpense[]
  reminderJobs    ReminderJob[]
  commercialRecommendations CommercialRecommendation[]

  @@index([lifecycleStatus, startDate, endDate])
}

model CampaignBrief {
  id                       String      @id @default(uuid()) @db.Uuid
  campaignId               String      @unique @db.Uuid
  sourceText               String?
  sourceTextHash           String?
  structuredRequirementsJson Json?
  parseStatus              ParseStatus @default(PENDING)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Inventory {
  id             String          @id @default(uuid()) @db.Uuid
  screenId       String          @db.Uuid
  inventoryType  String          @default("DIGITAL")
  productCode    String
  notes          String?
  status         InventoryStatus @default(UNKNOWN)
  /// Concurrent loop slots for digital faces (static stays 1). Digital defaults to 6 in app logic when 1.
  slotCapacity   Int             @default(1)
  staticSpecsJson Json?
  /// Last time a planner/vendor confirmed commercial availability for this face.
  availabilityConfirmedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  screen              Screen               @relation(fields: [screenId], references: [id], onDelete: Cascade)
  rateCards           RateCard[]
  mediaPlanItems      MediaPlanItem[]
  recommendations     Recommendation[]
  availabilityWindows AvailabilityWindow[]
  bookingItems        BookingItem[]
  changeLogs          InventoryChangeLog[]
}

model AvailabilityWindow {
  id            String                   @id @default(uuid()) @db.Uuid
  inventoryId   String                   @db.Uuid
  /// Prefer over parsing notes — links capacity rows to campaigns.
  campaignId    String?                  @db.Uuid
  startDate     DateTime
  endDate       DateTime
  status        AvailabilityWindowStatus @default(AVAILABLE)
  notes         String?
  /// How many loop slots this window consumes (digital multi-brand).
  slotsConsumed Int                      @default(1)
  /// Soft hold expiry for concurrent sales pitching (HELD only).
  expiresAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  inventory   Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  bookingItem BookingItem?

  @@index([inventoryId, startDate, endDate])
  @@index([status, expiresAt])
  @@index([campaignId, status])
}

model RateCard {
  id            String     @id @default(uuid()) @db.Uuid
  inventoryId   String     @db.Uuid
  currency      String     @default("INR")
  period        String
  amount        Decimal    @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  provenance    Provenance @default(UNKNOWN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model MediaPlan {
  id         String          @id @default(uuid()) @db.Uuid
  campaignId String          @db.Uuid
  name       String
  status     MediaPlanStatus @default(DRAFT)
  totalBudget Decimal?       @db.Decimal(14, 2)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    MediaPlanItem[]
  bookings Booking[]
}

model MediaPlanItem {
  id               String                 @id @default(uuid()) @db.Uuid
  mediaPlanId      String                 @db.Uuid
  inventoryId      String                 @db.Uuid
  budgetAllocated  Decimal                @db.Decimal(14, 2)
  explanationText  String?
  rank             Int?
  alternativesJson Json                   @default("[]")
  /// Vendor / owner response for site requests (PENDING until acted on).
  approvalStatus   MediaPlanItemApproval  @default(PENDING)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  mediaPlan MediaPlan @relation(fields: [mediaPlanId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

/// Explicit booking header — capacity remains on AvailabilityWindow.
model Booking {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?                @db.Uuid
  campaignId           String                 @db.Uuid
  mediaPlanId          String?                @db.Uuid
  status               BookingStatus          @default(HELD)
  paymentStatus        BookingPaymentStatus   @default(NOT_REQUIRED)
  executionStatus      BookingExecutionStatus @default(NOT_STARTED)
  startDate            DateTime
  endDate              DateTime
  expiresAt            DateTime?
  idempotencyKey       String?                @unique
  /// Set when a Phase 3 quote is accepted; optional for internal holds.
  acceptedQuoteRevisionId String?             @db.Uuid
  createdByUserId      String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenantOrganization Organization?       @relation("BookingTenantOrg", fields: [tenantOrganizationId], references: [id], onDelete: SetNull)
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaPlan          MediaPlan?          @relation(fields: [mediaPlanId], references: [id], onDelete: SetNull)
  acceptedQuoteRevision QuoteRevision?   @relation(fields: [acceptedQuoteRevisionId], references: [id], onDelete: SetNull)
  items              BookingItem[]
  transitions        BookingTransition[]
  changeEvents       BookingChangeOutbox[]
  executionTasks     ExecutionTask[]
  invoices           Invoice[]

  @@index([campaignId, status])
  @@index([tenantOrganizationId, status])
  @@index([expiresAt])
  @@index([startDate, endDate])
  @@index([mediaPlanId])
  @@index([acceptedQuoteRevisionId])
}

model InventoryChangeLog {
  id          String   @id @default(uuid()) @db.Uuid
  inventoryId String   @db.Uuid
  actorUserId String?  @db.Uuid
  changeType  String
  beforeJson  Json     @default("{}")
  afterJson   Json     @default("{}")
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
}

/// Durable booking change feed for Pulse / Bridge (not a second reservation ledger).
model BookingChangeOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @db.Uuid
  eventType        String
  payloadJson      Json      @default("{}")
  createdAt        DateTime  @default(now())
  deliveredAt      DateTime?
  deliveryAttempts Int       @default(0)
  lastError        String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([deliveredAt])
}

model BookingItem {
  id                   String           @id @default(uuid()) @db.Uuid
  bookingId            String           @db.Uuid
  inventoryId          String           @db.Uuid
  availabilityWindowId String?          @unique @db.Uuid
  vendorOrganizationId String?          @db.Uuid
  status               BookingItemStatus @default(HELD)
  slotsConsumed        Int              @default(1)
  mediaPlanItemId      String?          @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventory          Inventory           @relation(fields: [inventoryId], references: [id])
  availabilityWindow AvailabilityWindow? @relation(fields: [availabilityWindowId], references: [id], onDelete: SetNull)
  transitions        BookingTransition[]
  executionTasks     ExecutionTask[]
  proofRecords       ProofRecord[]
  creativeLinks      CreativeBookingItem[]

  @@unique([bookingId, inventoryId])
  @@index([status])
  @@index([vendorOrganizationId, status])
  @@index([inventoryId])
}

model BookingTransition {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @db.Uuid
  bookingItemId String?  @db.Uuid
  fromStatus    String
  toStatus      String
  actorUserId   String?  @db.Uuid
  reason        String?
  createdAt     DateTime @default(now())

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([bookingItemId, createdAt])
}

model Recommendation {
  id              String   @id @default(uuid()) @db.Uuid
  campaignId      String   @db.Uuid
  locationId      String?  @db.Uuid
  inventoryId     String?  @db.Uuid
  rank            Int
  score           Float
  reasonCodesJson Json?
  explanation     String?
  analysisId      String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  analysis  AIAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
}


/// Immutable commercial quote revision. Accept revalidates then reserves via AvailabilityWindow.
model QuoteRevision {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?             @db.Uuid
  campaignId           String?             @db.Uuid
  mediaPlanId          String?             @db.Uuid
  revisionNumber       Int                 @default(1)
  status               QuoteRevisionStatus @default(ISSUED)
  currency             String              @default("INR")
  /// Integer minor units (paise) — never float money on write paths.
  subtotalMinor        Int
  taxMinor             Int                 @default(0)
  totalMinor           Int
  assumptionsJson      Json                @default("{}")
  quantitiesJson       Json                @default("{}")
  rateVersionsJson     Json                @default("[]")
  chargesJson          Json                @default("[]")
  inventoryIds         Json                @default("[]")
  expiresAt            DateTime
  acceptedBookingId    String?             @db.Uuid
  acceptedAt           DateTime?
  createdByUserId      String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  acceptedBookings Booking[]
  proposals ProposalRevision[]
  invoices Invoice[]

  @@index([campaignId, status])
  @@index([tenantOrganizationId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

/// Admin audit when force-freeing BOOKED/HELD windows for a flight range.
model LocationAvailabilityRelease {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @db.Uuid
  locationIds  Json
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  reason       String
  affectedJson Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}


model ProposalRevision {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantOrganizationId String?        @db.Uuid
  campaignId           String         @db.Uuid
  revisionNumber       Int            @default(1)
  status               ProposalStatus @default(ISSUED)
  scenarioKind         ScenarioKind
  quoteRevisionId      String?        @db.Uuid
  currency             String         @default("INR")
  totalMinor           Int
  snapshotJson         Json           @default("{}")
  assumptionsJson      Json           @default("{}")
  expiresAt            DateTime
  acceptedBookingId    String?        @db.Uuid
  acceptedAt           DateTime?
  createdByUserId      String?        @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  campaign Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  quote    QuoteRevision?       @relation(fields: [quoteRevisionId], references: [id], onDelete: SetNull)
  shares   ProposalShareToken[]

  @@index([campaignId, status])
  @@index([tenantOrganizationId, status])
  @@index([quoteRevisionId])
}

model ProposalShareToken {
  id                  String    @id @default(uuid()) @db.Uuid
  proposalRevisionId  String    @db.Uuid
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  createdByUserId     String?   @db.Uuid
  createdAt           DateTime  @default(now())

  proposal ProposalRevision @relation(fields: [proposalRevisionId], references: [id], onDelete: Cascade)

  @@index([proposalRevisionId])
}



